# Vercel 프로젝트 설정 > Environment Variables 에 등록 (값은 여기에 적지 말 것)

# 사내 API가 노출되는 터널 주소 (Cloudflare Tunnel). 끝에 슬래시 없이.
# nexalab.app 바로 아래 1단계 서브도메인이어야 함 (2단계는 무료 와일드카드 SSL 범위 밖 — README 참고)
BACKEND_API_ORIGIN=https://weekreport-api.nexalab.app

# API 앞단에 Cloudflare Access를 걸 경우에만 필요 (아직 안 걸려 있음, 서비스 토큰은
# Access > Service Auth에서 발급)
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
